# Power BI Configuration
# Get these values from your Power BI workspace
POWERBI_WORKSPACE_ID=your_workspace_id_here
POWERBI_DASHBOARD_REPORT_ID=dashboard_report_id_here
POWERBI_RISKANALYSIS_REPORT_ID=risk_analysis_report_id_here
POWERBI_PRODUCTINTELLIGENCE_REPORT_ID=product_intelligence_report_id_here
POWERBI_MODELPERFORMANCE_REPORT_ID=model_performance_report_id_here
POWERBI_DATASET_ID=your_dataset_id_here

# Azure AD Configuration
# Get these values from Azure Portal > App registrations
POWERBI_CLIENT_ID=your_azure_app_id_here
POWERBI_CLIENT_SECRET=your_azure_app_secret_here
POWERBI_TENANT_ID=your_azure_tenant_id_here
POWERBI_USERNAME=your_powerbi_username@email.com
POWERBI_PASSWORD=your_powerbi_password_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
