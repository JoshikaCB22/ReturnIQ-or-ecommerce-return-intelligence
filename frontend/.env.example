# Power BI Configuration
# Get these values from your Power BI workspace and Azure AD app registration
REACT_APP_POWERBI_WORKSPACE_ID=your_workspace_id_here
REACT_APP_POWERBI_REPORT_ID=dashboard_report_id_here
REACT_APP_POWERBI_RISK_REPORT_ID=risk_analysis_report_id_here
REACT_APP_POWERBI_PRODUCT_REPORT_ID=product_intelligence_report_id_here
REACT_APP_POWERBI_MODEL_REPORT_ID=model_performance_report_id_here
REACT_APP_POWERBI_DATASET_ID=your_dataset_id_here

# Azure AD Configuration
# Get these values from Azure Portal > App registrations
REACT_APP_POWERBI_CLIENT_ID=your_azure_app_id_here
REACT_APP_POWERBI_TENANT_ID=your_azure_tenant_id_here

# Backend API
REACT_APP_API_URL=http://localhost:8000
